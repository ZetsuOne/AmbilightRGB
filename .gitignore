# Portable OpenRGB binaries (download separately / ship via Releases)
bin/OpenRGB/*
!bin/OpenRGB/.gitkeep

# Release / PyInstaller output (keep build scripts tracked)
dist/
build/**
!build/build_release.bat
!build/installer.iss

